"""
We have 2 variables glass1 and glass2. glass1 contains milk and glass2 contains juice. Write 3 lines of code to switch the contents of the variables.
You are not allowed to type the words "milk" or "juice".
You are only allowed to use variables to solve this exercise. 
"""

glass1 = "?"
glass2 = "?"
juicy = False

def liquid():
    global juicy

    if juicy:
        glass1 = "milk"
        glass2 = "juice"
        print("\nGlass 1 is filled with:", glass1, "\nGlass 2 is filled with:", glass2)
        juicy = False
    else:
        glass1 = "juice"
        glass2 = "milk"
        print("\nGlass 1 is filled with:", glass1, "\nGlass 2 is filled with:", glass2)
        juicy = True

running = int(input("How many times should this run? "))

for i in range(running):
    liquid()
